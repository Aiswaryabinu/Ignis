DATABASE_URL=postgresql+psycopg://brightloop:brightloop@localhost:5432/brightloop
SECRET_KEY=replace-with-a-long-random-string-of-32+-bytes
ENABLE_SCHEDULER=false

# --- production settings ---
# ENVIRONMENT=production refuses to start with a weak SECRET_KEY
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
# MAIL_BACKEND: console (log only) | smtp
MAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Brightloop Billing <billing@brightloop.example>
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
