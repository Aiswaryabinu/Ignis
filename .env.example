DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5435/subscription_db
JWT_SECRET=replace-with-a-long-random-string-of-32+-bytes
SCHEDULER_ENABLED=false

# --- production settings ---
# ENVIRONMENT=production refuses to start with a weak JWT_SECRET
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
# MAIL_BACKEND: console (log only) | smtp
MAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Brightloop Billing <billing@brightloop.example>
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_WINDOW_SECONDS=300
REGISTER_MAX_PER_IP=30
