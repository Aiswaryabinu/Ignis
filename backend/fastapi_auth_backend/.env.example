APP_NAME=Ignis Auth API
DEBUG=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ignis_auth
JWT_SECRET_KEY=replace_with_random_secret
TOKEN_PEPPER=replace_with_another_random_secret
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=14
RESET_TOKEN_MINUTES=20
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_SIGNIN=10/minute
RATE_LIMIT_FORGOT=3/hour
